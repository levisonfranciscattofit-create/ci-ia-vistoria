<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cielo | RealWear HMT-1</title>
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    :root { --cielo: #00aeef; --danger: #ff4b5c; --bg: #010a12; }
    body { background: #000; color: white; font-family: 'Rajdhani', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; overflow: hidden; }
    .glass { width: 95%; max-width: 500px; text-align: center; border: 2px solid var(--cielo); border-radius: 20px; padding: 20px; }
    .logo { font-family: 'Orbitron'; color: var(--cielo); font-size: 24px; margin-bottom: 20px; }
    
    /* Input gigante para o HMT-1 focar fácil */
    input { width: 100%; background: #111; border: 3px solid var(--cielo); border-radius: 10px; padding: 20px; color: #fff; text-align: center; font-size: 30px; font-family: 'Orbitron'; margin-bottom: 20px; }
    
    #fala-preview { min-height: 120px; font-size: 22px; color: #facc15; border: 1px solid #333; border-radius: 10px; padding: 15px; background: #050505; margin-bottom: 20px; }
    .mic-icon { width: 70px; height: 70px; background: var(--danger); border-radius: 50%; margin: 0 auto 20px; display: none; animation: pulse 1s infinite; align-items: center; justify-content: center; font-size: 30px; }
    #timer { font-size: 80px; font-family: 'Orbitron'; color: var(--cielo); }
    
    @keyframes pulse { 0% { transform: scale(1); } 70% { transform: scale(1.2); } 100% { transform: scale(1); } }
  </style>
</head>
<body>

<div class="glass">
  <div class="logo">HMT-1 VISTORIA</div>
  
  <input id="serialInput" type="text" placeholder="Diga 'ESCANEAR'" autofocus>
  
  <div id="micIcon" class="mic-icon">🎤</div>
  <div id="fala-preview">Aguardando bipe...</div>
  <div id="timer"></div>
</div>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyDOCUw3ZQlLUglizIUP1Ive6PA9ee_-5nI",
  authDomain: "poc-realwear.firebaseapp.com",
  databaseURL: "https://poc-realwear-default-rtdb.firebaseio.com",
  projectId: "poc-realwear"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.database();

const dicionario = {
    "TELA QUEBRADA": ["tela", "quebrad", "trinc", "visor", "vidro"],
    "TECLADO RUIM": ["tecla", "botão", "botao", "teclad"],
    "FALTA DE RELEVO": ["relevo", "liso", "apagad"]
};

let recognition;
let gravando = false;

// --- LÓGICA DO HMT-1 ---
const input = document.getElementById('serialInput');

// 1. Garante que o foco nunca saia do input (importante para o RealWear)
document.addEventListener('click', () => input.focus());

// 2. Detecta o "Enter" que o scanner do HMT-1 dá automaticamente
input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        startMic();
    }
});

function startMic() {
    if(gravando) return;
    gravando = true;
    
    document.getElementById('micIcon').style.display = "flex";
    document.getElementById('fala-preview').innerText = "Ouvindo defeitos...";

    const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new Speech();
    recognition.lang = "pt-BR";
    recognition.continuous = true;
    recognition.interimResults = true;

    recognition.onresult = (event) => {
        let texto = "";
        for (let i = 0; i < event.results.length; i++) {
            texto += event.results[i][0].transcript;
        }
        document.getElementById('fala-preview').innerText = texto.toLowerCase();

        // Comandos de voz para o RealWear finalizar
        if (texto.toLowerCase().includes("pronto") || texto.toLowerCase().includes("enviar") || texto.toLowerCase().includes("finalizar")) {
            finalizarHMT();
        }
    };
    recognition.start();
}

function finalizarHMT() {
    if(!gravando) return;
    gravando = false;
    if(recognition) recognition.stop();

    const texto = document.getElementById('fala-preview').innerText.toLowerCase();
    const encontrados = [];
    Object.keys(dicionario).forEach(erro => {
        if (dicionario[erro].some(p => texto.includes(p))) encontrados.push(erro);
    });

    db.ref("inspecao").push({
        serial: input.value,
        defeitos: encontrados,
        transcricao: texto,
        data: new Date().toLocaleString()
    });

    // Feedback visual rápido antes de resetar
    document.getElementById('fala-preview').innerHTML = "✅ ENVIADO COM SUCESSO!";
    
    let c = 3;
    const t = setInterval(() => {
        document.getElementById('timer').innerText = c--;
        if(c < 0) { clearInterval(t); location.reload(); }
    }, 1000);
}
</script>
</body>
</html>
